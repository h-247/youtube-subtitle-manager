# ========================================================
# YouTube Subtitle Manager - Environment Configuration Template
# Copy this file to .env and configure your values.
# ========================================================

# --- Application & Environment ---
PROJECT_NAME="YouTube Subtitle Manager"
ENVIRONMENT=development
DEBUG=True

# --- Database Configuration (PostgreSQL) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=youtube_subtitles
# For local Windows direct execution:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/youtube_subtitles
# Note: In Docker Compose, the host is 'db', e.g.:
# DATABASE_URL=postgresql://postgres:postgres@db:5432/youtube_subtitles

# --- Authentication & JWT ---
# Generate a secure 32+ character key using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_32_character_secret_key_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# --- Frontend Application ---
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# --- Google Drive OAuth 2.0 Credentials ---
# Create an OAuth 2.0 Client ID (Web Application) in Google Cloud Console
# Enabled APIs: Google Drive API
# Authorized redirect URI: http://localhost:8000/api/drive/callback
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:8000/api/drive/callback
GOOGLE_DRIVE_FOLDER_NAME="YouTube Subtitles"

# --- YouTube Subtitle Rate Limiting & Retry Configuration ---
# Number of retry attempts when encountering YouTube HTTP 429 rate limiting (default: 3)
SUBTITLE_MAX_RETRIES=3
# Initial backoff delay in seconds for exponential backoff (default: 1.0)
SUBTITLE_RETRY_DELAY=1.0

# --- YouTube Cookies Configuration (Bypasses HTTP 429 / bot verification) ---
# Option 1 (Recommended): Place exported cookies.txt in project root or backend folder
YTDLP_COOKIES_FILE=cookies.txt
# Option 2 (Direct browser extraction, e.g. brave, chrome, firefox, edge):
# Note: On Windows, Chromium browsers (Brave/Chrome) lock the cookie file while running.
# YTDLP_COOKIES_FROM_BROWSER=brave

